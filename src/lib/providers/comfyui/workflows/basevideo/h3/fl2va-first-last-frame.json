{
  "1": {
    "class_type": "RHMiniMaxH3FL2VATextEncoderLoader",
    "inputs": {
      "model_root": "MiniMax-H3",
      "dtype": "auto",
      "text_encoder_path": "qwen3-vl-32b-int8_convrot.safetensors"
    },
    "_meta": { "title": "FL2VA Qwen3-VL Loader" }
  },
  "2": {
    "class_type": "RHMiniMaxH3FL2VAModelLoader",
    "inputs": {
      "model_root": "MiniMax-H3",
      "dtype": "auto",
      "transformer_path": "MiniMax-H3-FL2VA-int8_convrot.safetensors"
    },
    "_meta": { "title": "FL2VA DiT Loader" }
  },
  "3": {
    "class_type": "RHMiniMaxH3FL2VAVAELoader",
    "inputs": {
      "model_root": "MiniMax-H3",
      "video_vae_path": "MiniMax-H3-video_vae.safetensors",
      "audio_vae_path": "MiniMax-H3-audio_vae.safetensors"
    },
    "_meta": { "title": "FL2VA Dual VAE Loader" }
  },
  "4": {
    "class_type": "LoadImage",
    "inputs": { "image": "example.png" },
    "_meta": { "title": "First frame" }
  },
  "5": {
    "class_type": "RHMiniMaxH3FL2VAFirstFrameCondition",
    "inputs": {
      "first_frame": ["4", 0],
      "last_frame": ["6", 0]
    },
    "_meta": { "title": "First / First+Last" }
  },
  "6": {
    "class_type": "LoadImage",
    "inputs": { "image": "example.png" },
    "_meta": { "title": "Last frame" }
  },
  "7": {
    "class_type": "RHMiniMaxH3FL2VATarget",
    "inputs": {
      "keyframes": ["5", 0],
      "aspect_ratio": "16:9",
      "duration_seconds": 5,
      "width": 832,
      "height": 480
    }
  },
  "8": {
    "class_type": "RHMiniMaxH3FL2VAEncode",
    "inputs": {
      "h3_text_encoder": ["1", 0],
      "h3_vae_bundle": ["3", 0],
      "target": ["7", 0],
      "keyframes": ["5", 0],
      "prompt": "Continue naturally between the provided keyframes while preserving subject identity, lighting, composition, and colour grade. Generate synchronized ambient audio. No subtitles, logos, or text overlays."
    }
  },
  "9": {
    "class_type": "RHMiniMaxH3EmptyAVLatent",
    "inputs": { "target": ["7", 0] },
    "_meta": { "title": "Empty AV Latent" }
  },
  "10": {
    "class_type": "RHMiniMaxH3DualSigmaSampler",
    "inputs": {
      "h3_model": ["2", 0],
      "conditioning": ["8", 0],
      "av_latent": ["9", 0],
      "seed": 42,
      "sigma_points": 21,
      "video_shift": 12,
      "audio_shift": 3,
      "accel": "off",
      "denoise_video": true,
      "cache_dit_rdt": 0.12,
      "cache_dit_mc": 2,
      "cache_dit_warmup": 4,
      "velocity_stride": 4,
      "sampler_mode": "res_multistep"
    },
    "_meta": { "title": "Dual Sigma Sampler" }
  },
  "11": {
    "class_type": "RHMiniMaxH3DecodeAV",
    "inputs": {
      "h3_vae_bundle": ["3", 0],
      "sampled_av_latent": ["10", 0]
    },
    "_meta": { "title": "Decode Video + Audio" }
  },
  "12": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["11", 0],
      "audio": ["11", 1],
      "fps": 24,
      "bit_depth": 8
    }
  },
  "13": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["12", 0],
      "filename_prefix": "minimax_h3/fl2va_first_last_frame",
      "format": "mp4",
      "codec": "h264"
    }
  }
}
